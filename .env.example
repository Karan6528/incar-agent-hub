# Copy to .env and fill in.

# Shared API key protecting /mcp, /a2a and /api. Leave empty ONLY for local development.
API_KEY=dev-key

# Public URL of this service (used in the A2A Agent Card).
# Locally: http://localhost:8000 ; on App Runner: https://xxxx.eu-central-1.awsapprunner.com
PUBLIC_BASE_URL=http://localhost:8000

# LLM (optional). Without a key the host agent runs in rule-based offline mode.
# Any OpenAI-compatible API works:
#   OpenAI: LLM_BASE_URL empty, LLM_MODEL=gpt-4o-mini
#   Groq (free tier): LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b  (llama-3.3 was retired Aug 2026)
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, LLM_MODEL=gemini-2.5-flash
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=qwen2.5
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
